{
  "name": "SOCify Digital Autopsy",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": true,
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": true
    }
  },
  "forwardPorts": [5000, 5001],
  "portsAttributes": {
    "5000": {
      "label": "SOCify",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "5001": {
      "label": "SOCify V4 Demo",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "SOCIFY_ENV": "development",
    "SOCIFY_DATABASE": "/workspaces/SOCifyProject/instance/socify.db",
    "SOCIFY_HOST": "0.0.0.0",
    "SOCIFY_PORT": "5000"
  },
  "postCreateCommand": "bash scripts/setup_devcontainer.sh",
  "postStartCommand": ".venv/bin/python -m scripts.start_codespace --check",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
