{
  "name": "SOCify Digital Autopsy",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "SOCify",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "SOCIFY_ENV": "development",
    "SOCIFY_DATABASE": "/workspaces/SOCifyProject/instance/socify.db",
    "SOCIFY_HOST": "0.0.0.0",
    "SOCIFY_PORT": "5000"
  },
  "postCreateCommand": "python -m pip install -r requirements.txt -r requirements-dev.txt && python -m scripts.prepare_codespace && bash -lc 'set -a; source instance/codespaces.env; set +a; python create_db.py'",
  "postStartCommand": "python -m scripts.start_codespace --check"
}
