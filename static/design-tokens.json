        "ar": 1.45,
        "en": 1.25
      }
    },
    "tracking": 0,
    "scale": {
      "meta": 12,
      "caption": 13,
      "body": 14,
      "body-ar": 15,
      "section": 16,
      "subpage": 20,
      "page": 28
    }
  },
  "visualReference": {
    "type": "SOCify Graphite",
    "description": "A night-shift operations room: graphite surfaces separated by hairlines, with royal navy as the single accent for the primary action, checked controls, focus, the current selection, links and single-value rings. Severity tags are solid fills. Charts with several series use data colours. Headings in Kufam, everything else in IBM Plex Sans Arabic. Design guidance adapted from unslop by Damir Sokolovsky (CC BY 4.0)."
  },
